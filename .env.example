# Production Environment Configuration & Managed Secret Store Guidelines
# In production, inject SECRET_KEY, ENCRYPTION_KEY, and DATABASE_URL from a managed secret manager
# (e.g., AWS Secrets Manager, HashiCorp Vault, Azure Key Vault, or Kubernetes Secrets).

APP_ENV=production
SECRET_KEY=generate-a-long-random-secret-48-chars-minimum
ENCRYPTION_KEY=generate-with-python-c-from-cryptography-fernet-import-Fernet-print-Fernet-generate_key-decode
DATABASE_URL=postgresql+psycopg://securexerox:change-me@postgres:5432/securexerox?sslmode=require
ALLOWED_ORIGINS=https://app.example.com
TRUSTED_HOSTS=api.example.com
FRONTEND_URL=https://app.example.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
SHOP_OAUTH_EMAILS=approved-shop@example.com